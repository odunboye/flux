package nebula-flux
version = 0.1.0
authors = "Odun Adeboye"
license = "MIT"
brief   = "Glue lifting idris2-pg/nebula's IO (Either PGError a) calls into Flux's AppProg/Handler pipeline"
readme  = "README.md"

depends = flux
        , nebula
        , idris2-pg
        , idris2-pg-async

modules = Nebula.PG
        , Nebula.Pool

main = Nebula.PG

sourcedir = "src"
