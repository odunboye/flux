package flux-db-flux
version = 0.3.0
authors = "Odun Adeboye"
license = "MIT"
brief   = "Glue lifting idris2-pg/flux-db's IO (Either PGError a) calls into Flux's AppProg/Handler pipeline"
readme  = "README.md"

depends = flux
        , flux-db
        , idris2-pg
        , idris2-pg-async

modules = Flux.DB.PG
        , Flux.DB.Pool

main = Flux.DB.PG

sourcedir = "src"
