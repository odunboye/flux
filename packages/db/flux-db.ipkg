package flux-db
version = 0.3.0
authors = "Odun Adeboye"
license = "MIT"
brief   = "A derivable active-record/query-builder layer for flux-postgres (Row<->record mapping, derived CRUD, a typed query builder) - flux-postgres itself stays a primitive wire-protocol client only"
readme  = "README.md"

-- packages to add to search path
depends = flux-postgres
        , elab-util
        , json-simple

-- modules to install
modules = Flux.DB.Migration
        , Flux.DB.Field
        , Flux.DB.Row
        , Flux.DB.Table
        , Flux.DB.ColumnType
        , Flux.DB.Query
        , Flux.DB.Derive.ActiveRecord
        , Flux.DB.Crud
        , Flux.DB.Repository
        , Flux.DB.ObjectFromJSON
-- this is a library, not a standalone executable - no single module
-- among the above is a natural "load at REPL" entry point (unlike
-- before, when Flux.DB.PG served that role; see flux-db-flux, which took
-- it with the module itself)
-- main =

sourcedir = "src"
