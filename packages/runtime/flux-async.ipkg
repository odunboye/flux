package flux-async
version = 0.1.0
brief = "Flux's owned-task runtime (under development)"
depends = elin, bytestring, elab-util, posix
sourcedir = "src"
opts = "-i ."
prebuild = "make native"
modules = Flux.Async.Core
        , Flux.Async.Native
        , Flux.Async.Runner
        , Flux.Async.Socket
        , Flux.Stream.Core
        , Flux.Stream.Pull
        , Flux.Stream.Chunk
        , Flux.Stream.Bytes
        , Flux.Stream.Internal.Bytes
        , Flux.Stream.Resource
        , Flux.Stream
        , Flux.Stream.Socket
        , Flux.Stream.Posix
        , Flux.Async.Server
        , Flux.Async.Standalone
