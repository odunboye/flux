# Run from the package root: make -f test/Makefile.native check
# Separate from the main build while the runtime integration is in progress.
CC ?= cc
NATIVE_CHECK_FLAGS = -O1 -g -Wall -Wextra -Werror -std=c11 -pthread -Ic
NATIVE_SANITIZERS ?= -fsanitize=address,undefined

.PHONY: check
check:
	mkdir -p build/native
	$(CC) $(NATIVE_CHECK_FLAGS) $(NATIVE_SANITIZERS) c/flux_native.c test/native_test.c -o build/native/native-sanitized
	./build/native/native-sanitized
	$(CC) $(NATIVE_CHECK_FLAGS) $(NATIVE_SANITIZERS) c/flux_native.c test/native_stress_test.c -o build/native/native-stress
	./build/native/native-stress
	$(CC) $(NATIVE_CHECK_FLAGS) $(NATIVE_SANITIZERS) c/flux_native.c test/watchdog_test.c -o build/native/watchdog-test
	./build/native/watchdog-test
