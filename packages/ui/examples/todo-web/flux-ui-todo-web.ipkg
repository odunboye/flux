package flux-ui-todo-web

authors    = "Odun Adeboye"
version    = 0.1.0
brief      = "Flux UI Todo — browser build (xterm.js + Idris2 JS backend)"

-- ─── Dependencies ──────────────────────────────────────────────────────────
-- Build order:
--   1. cd ../..  && idris2 --install flux-ui.ipkg
--   2. cd ../todo && idris2 --install flux-ui-todo.ipkg
--   3. cd .      && make  (runs the above, then this)

depends = flux-ui, flux-ui-todo

-- ─── Source ────────────────────────────────────────────────────────────────

sourcedir  = "src"
executable = "flux-ui-todo-web"
main       = Main
