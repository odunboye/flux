package flux-ui-counter-terminal
depends = flux-ui
sourcedir = "."
modules = Counter, Main
main = Main
executable = counter-terminal
prebuild = "mkdir -p build/exec/counter-terminal_app && cc -dynamiclib ../../c/fluxuitui.c -o build/exec/counter-terminal_app/libfluxuitui.dylib 2>/dev/null || cc -shared -fPIC ../../c/fluxuitui.c -o build/exec/counter-terminal_app/libfluxuitui.so"
