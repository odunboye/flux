{
  "appId":   "dev.fluxui.todo",
  "appName": "Flux UI Todo",
  "webDir":  "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0d1117"
    },
    "StatusBar": {
      "style":           "dark",
      "backgroundColor": "#0d1117"
    }
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": true
  }
}
