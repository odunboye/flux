{
  "version": 1,
  "models": {
    "CreateTodoRequest": {"title": "string"},
    "TodoView": {"id": "string", "title": "string", "done": "bool"},
    "TodoIdRequest": {"id": "string"},
    "UpdateTodoRequest": {"id": "string", "title": "string", "done": "bool"},
