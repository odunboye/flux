package flux-client
version = 0.1.0
brief = "Generated RPC client support for Flux UI applications"
depends = flux-ui, json-simple
sourcedir = "client/src"
prebuild = "make native-client"
modules = Flux.Platform.Client
        , Flux.Platform.Client.Auth
        , Flux.Platform.Client.Web
        , Flux.Platform.Client.Native
