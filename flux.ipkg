package flux
version = 0.2.0
authors = "Odun Adeboye"
-- maintainers =
-- license =
brief   = "A production-grade HTTP server framework for Idris2"
-- readme =
-- homepage =
-- sourceloc =
-- bugtracker =

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
depends    = streams-posix
           , async-posix

-- modules to install
modules = Flux.Core.HTTP
        , Flux.Core.Router
        , Flux.Core.Middleware
        , Flux.Data.JSON
        , Flux.Server.Config
        , Flux.Server.Logging
        , Flux.Server.Health
        , Flux.Middleware.RequestId
        , Flux.Middleware.Timing
        , Flux.Middleware.Cookies
        , Flux.Middleware.Session
        , Flux

-- main file (i.e. file to load at REPL) - this is a library, not a
-- standalone executable; see examples/ for a runnable server.
main = Flux

-- name of executable
--executable = flux-server
-- opts =
sourcedir = "src"
-- builddir =
-- outputdir =

-- script to run before building
-- prebuild =

-- script to run after building
-- postbuild =

-- script to run after building, before installing
-- preinstall =

-- script to run after installing
-- postinstall =

-- script to run before cleaning
-- preclean =

-- script to run after cleaning
-- postclean =
