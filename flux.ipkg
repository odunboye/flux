package flux
version = 0.3.0
authors = "Odun Adeboye"
-- maintainers =
-- license =
brief   = "An HTTP/1.1 server framework for Idris2 (platform preview)"
-- readme =
-- homepage =
-- sourceloc =
-- bugtracker =

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
depends    = flux-runtime
           , posix
           , ref1
           , json-simple

-- modules to install
modules = Flux.Core.Runtime
        , Flux.Core.HTTP
        , Flux.Core.Router
        , Flux.Core.Middleware
        , Flux.Middleware.Internal.Stripe
        , Flux.Middleware.Internal.Random
        , Flux.Middleware.JSON
        , Flux.Server.Assets
        , Flux.Server.Config
        , Flux.Server.Logging
        , Flux.Server.Health
        , Flux.Middleware.RequestId
        , Flux.Middleware.Timing
        , Flux.Middleware.Cookies
        , Flux.Middleware.Session
        , Flux.Middleware.Static
        , Flux.Middleware.RpcCors
        , Flux

-- main file (i.e. file to load at REPL) - this is a library, not a
-- standalone executable; see examples/ for a runnable server.
main = Flux

-- name of executable
--executable = flux-server
-- opts =
sourcedir = "src"
-- builddir =
-- outputdir =

-- script to run before building
-- prebuild =

-- script to run after building
-- postbuild =

-- script to run after building, before installing
-- preinstall =

-- script to run after installing
-- postinstall =

-- script to run before cleaning
-- preclean =

-- script to run after cleaning
-- postclean =
