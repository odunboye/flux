package flux
version = 0.1.0
authors = "Odun Adeboye"
-- maintainers =
-- license =
-- brief =
-- readme =
-- homepage =
-- sourceloc =
-- bugtracker =

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
depends    = streams-posix
           , async-posix

-- modules to install
modules = Flux
        , HTTP
        , HTTP11
        , Router
        , Middleware
        , Logging
        , JSON
        , Config
        , RequestId
        , Timing
        , Health
        , Examples
        , Main

-- main file (i.e. file to load at REPL)
main = Main

-- name of executable
--executable = flux-server
-- opts =
sourcedir = "src"
